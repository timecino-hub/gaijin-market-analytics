bvvd-analysis.duckdns.org {
  encode zstd gzip
  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }

  route {
    @write_method method POST PUT PATCH DELETE CONNECT TRACE
    respond @write_method "Read-only preview" 405

    @blocked_ui path /imports /imports/* /screen-recognition /screen-recognition/*
    respond @blocked_ui "Not found" 404

    @item_list {
      method GET HEAD
      path /api/v1/items
    }
    reverse_proxy @item_list api:8000

    @item_detail {
      method GET HEAD
      path_regexp public_item ^/api/v1/items/[0-9]+(?:/order-book)?$
    }
    reverse_proxy @item_detail api:8000

    @item_history {
      method GET HEAD
      path_regexp public_history ^/api/v1/items/[0-9]+/historical-trades$
    }
    reverse_proxy @item_history api:8000

    @data_status {
      method GET HEAD
      path /api/v1/data-status
    }
    reverse_proxy @data_status api:8000

    @opportunities {
      method GET HEAD
      path /api/v1/opportunities
    }
    reverse_proxy @opportunities api:8000

    @vehicle_potential {
      method GET HEAD
      path /api/v1/vehicle-potential
    }
    reverse_proxy @vehicle_potential api:8000

    @vehicle_potential_item {
      method GET HEAD
      path_regexp public_vehicle_potential ^/api/v1/vehicle-potential/[0-9]+$
    }
    reverse_proxy @vehicle_potential_item api:8000

    @strategy_evidence {
      method GET HEAD
      path /api/v1/strategy-evidence
    }
    reverse_proxy @strategy_evidence api:8000

    @general_strategy {
      method GET HEAD
      path /api/v1/general-strategy
    }
    reverse_proxy @general_strategy api:8000

    @private_api path /api/*
    respond @private_api "Read-only preview" 405

    @health {
      method GET HEAD
      path /health /ready
    }
    reverse_proxy @health api:8000

    reverse_proxy web:3000
  }
}
